# codespell ignore words list — only words codespell mis-flags as typos.
# Each must correspond to a real false-positive in the tree. Matching is
# case-insensitive.
hass
# Comparative statics is the economics term used by the provider's
# PenaltyPolicy schema; preserve its digest-bound contract description.
statics
# "deriver" is the real name of the derivation component (a thing that derives).
deriver
# LOD is the level-of-detail parameter (graph rendering term), not a typo of "load".
lod
# NotIn is the SPARQL/filter operator identifier (NOT IN), emitted as a CamelCase name.
notin
# "asend" is the async-generator protocol method (agen.asend), not "ascend".
asend
