# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv*/

# Test / lint / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

*maturin.lock

# uv
.uv-workspace-siblings/

# Docs build output (published via GitHub Pages CI, not committed)
site/

# Editors / OS
.DS_Store
*.swp

# Fleet-shared entries required by the gitignore-convergence hook
/.specify/
!/.specify/
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md
dist-*/
target-*/
.venv/
.pytest_tmp/
node_modules/
reports/
scratch/
sdist/
target/

# Spec status is computed at read time (pipelines-hook spec-status --write), never committed.
specs/*/status.json
