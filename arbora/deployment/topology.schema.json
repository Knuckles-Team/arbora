{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbora.invalid/schemas/production-topology-input-v1.json",
  "title": "Arbora production topology input",
  "description": "Measured capacity and external-authority references for the one renderable Arbora production topology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "authority",
    "environment",
    "namespace",
    "engine_identity_contract",
    "resource_pool",
    "engine",
    "oidc",
    "authorities",
    "release",
    "workloads"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "arbora.services/v1" },
    "kind": { "const": "ArboraProductionTopologyInput" },
    "authority": { "type": "string", "minLength": 1 },
    "environment": { "const": "production" },
    "engine_identity_contract": { "$ref": "#/$defs/engineIdentityBinding" },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "resource_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "measured_at", "evidence_ref", "nodes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "measured_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "id", "hostname", "zone", "allocatable"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 0 },
              "id": { "type": "string", "minLength": 1 },
              "hostname": { "type": "string", "minLength": 1 },
              "zone": { "type": "string", "minLength": 1 },
              "allocatable": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cpu_millicores", "memory_bytes"],
                "properties": {
                  "cpu_millicores": { "type": "integer", "minimum": 1 },
                  "memory_bytes": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_service_name",
        "peer_service_name",
        "peer_port",
        "client_port",
        "metrics_port",
        "tls_server_name",
        "tls_verified",
        "ca_bundle_configmap",
        "ca_bundle_path",
        "discovery_ref",
        "discovery_verified"
      ],
      "properties": {
        "client_service_name": { "type": "string", "minLength": 1 },
        "peer_service_name": { "type": "string", "minLength": 1 },
        "peer_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "client_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "metrics_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls_server_name": { "type": "string", "minLength": 1 },
        "tls_verified": { "const": true },
        "ca_bundle_configmap": { "type": "string", "minLength": 1 },
        "ca_bundle_path": { "type": "string", "pattern": "^/[^ ]+$" },
        "discovery_ref": { "type": "string", "minLength": 1 },
        "discovery_verified": { "const": true }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "jwks_url", "client_id", "verified"],
      "properties": {
        "issuer": { "type": "string", "pattern": "^https://[^ ]+$" },
        "audience": { "type": "string", "minLength": 1 },
        "jwks_url": { "type": "string", "pattern": "^https://[^ ]+$" },
        "client_id": { "type": "string", "minLength": 1 },
        "verified": { "const": true }
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configmap_name", "configmap_retention", "configmap_ref", "secret_name", "secret_retention", "secret_ref", "session_store"],
      "properties": {
        "configmap_name": { "type": "string", "minLength": 1 },
        "configmap_retention": { "const": "Retain" },
        "configmap_ref": { "type": "string", "minLength": 1 },
        "secret_name": { "type": "string", "minLength": 1 },
        "secret_retention": { "const": "Retain" },
        "secret_ref": { "type": "string", "minLength": 1 },
        "session_store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "service_name", "namespace", "authority_ref", "retention"],
          "properties": {
            "kind": { "const": "external" },
            "service_name": { "type": "string", "minLength": 1 },
            "namespace": { "type": "string", "minLength": 1 },
            "authority_ref": { "type": "string", "minLength": 1 },
            "retention": { "const": "Retain" }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollout_evidence_ref", "rollback_evidence_ref"],
      "properties": {
        "rollout_evidence_ref": { "type": "string", "minLength": 1 },
        "rollback_evidence_ref": { "type": "string", "minLength": 1 }
      }
    },
    "workloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "dispatch", "ingest", "mining"],
      "properties": {
        "gateway": {
          "allOf": [
            { "$ref": "#/$defs/workload" },
            {
              "type": "object",
              "required": ["service_port", "public_host", "public_tls_secret"]
            }
          ]
        },
        "dispatch": { "$ref": "#/$defs/workload" },
        "ingest": { "$ref": "#/$defs/workload" },
        "mining": { "$ref": "#/$defs/workload" }
      }
    }
  },
  "$defs": {
    "engineIdentityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "const": "services/epistemic-graph/k8s/production/engine-identity-contract.v1.json" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "entrypoint",
        "image",
        "previous_image",
        "replicas",
        "resources",
        "pdb_max_unavailable",
        "termination_grace_seconds",
        "pre_stop_seconds",
        "metric"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$" },
        "previous_image": { "type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$" },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "desired", "max", "scale_up_step", "scale_down_step", "up_stabilization_seconds", "down_stabilization_seconds"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "desired": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 },
            "scale_up_step": { "type": "integer", "minimum": 1 },
            "scale_down_step": { "type": "integer", "minimum": 1 },
            "up_stabilization_seconds": { "type": "integer", "minimum": 0 },
            "down_stabilization_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_request_millicores", "cpu_limit_millicores", "memory_request_bytes", "memory_limit_bytes"],
          "properties": {
            "cpu_request_millicores": { "type": "integer", "minimum": 1 },
            "cpu_limit_millicores": { "type": "integer", "minimum": 1 },
            "memory_request_bytes": { "type": "integer", "minimum": 1 },
            "memory_limit_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "pdb_max_unavailable": { "type": "integer", "minimum": 0 },
        "termination_grace_seconds": { "type": "integer", "minimum": 1 },
        "pre_stop_seconds": { "type": "integer", "minimum": 0 },
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": ["mode", "name", "target", "adapter_ref"],
              "properties": {
                "mode": { "const": "hpa" },
                "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" },
                "target": { "type": "string", "pattern": "^[0-9]+(?:m)?$" },
                "adapter_ref": { "type": "string", "minLength": 1 }
              }
            },
            {
              "required": ["mode", "reason"],
              "properties": {
                "mode": { "const": "fixed" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "service_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "public_host": { "type": "string", "minLength": 1 },
        "public_tls_secret": { "type": "string", "minLength": 1 }
      }
    }
  }
}
