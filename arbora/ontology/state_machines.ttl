# ---------------------------------------------------------------------------
# Fleet onboarding handshake (ARBORA-FLEET-R080.1, R080.3).
# Python: OnboardingState, OnboardingEvent, ONBOARDING_EDGES in arbora/fleet/onboarding_machine.py.
# ---------------------------------------------------------------------------

arbora:FleetOnboardingMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Fleet onboarding" ;
    rdfs:comment "The onboarding handshake of one connector: idle, debouncing a burst, running a pass, backing off after an error, awaiting approval of a held mass withdrawal, or failed; failed leaves on the slow-retry edge once the process lease is live. No state is terminal." ;
    :initialState arbora:OnboardingIdle ;
    :hasState arbora:OnboardingIdle ,
        arbora:OnboardingDebouncing ,
        arbora:OnboardingRunning ,
        arbora:OnboardingBackoff ,
        arbora:OnboardingAwaitingApproval ,
        arbora:OnboardingFailed .

arbora:OnboardingState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Fleet onboarding state" .

arbora:OnboardingTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Fleet onboarding transition" .

arbora:OnboardingEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Fleet onboarding event" .

arbora:AttemptsLeft a owl:Class ;
    rdfs:subClassOf :TransitionGuard ;
    rdfs:label "AttemptsLeft" ;
    :storedForm "attempts_left" .

arbora:NoAttemptsLeft a owl:Class ;
    rdfs:subClassOf :TransitionGuard ;
    rdfs:label "NoAttemptsLeft" ;
    :storedForm "no_attempts_left" .

arbora:OnboardingLeaseLive a owl:Class ;
    rdfs:subClassOf :TransitionGuard ;
    rdfs:label "OnboardingLeaseLive" ;
    :storedForm "lease_live" .

arbora:OnboardingTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Fleet onboarding transition refused" ;
    rdfs:comment "IllegalOnboardingTransition, code ONBOARDING_TRANSITION_ILLEGAL, fields machine (fleet_onboarding), from_state and event. The onboarding state does not change." .

arbora:OnboardingIdle a owl:Class ;
    rdfs:subClassOf arbora:OnboardingState ;
    :storedForm "idle" .

arbora:OnboardingDebouncing a owl:Class ;
    rdfs:subClassOf arbora:OnboardingState ;
    :storedForm "debouncing" .

arbora:OnboardingRunning a owl:Class ;
    rdfs:subClassOf arbora:OnboardingState ;
    :storedForm "running" .

arbora:OnboardingBackoff a owl:Class ;
    rdfs:subClassOf arbora:OnboardingState ;
    :storedForm "backoff" .

arbora:OnboardingAwaitingApproval a owl:Class ;
    rdfs:subClassOf arbora:OnboardingState ;
    :storedForm "awaiting_approval" .

arbora:OnboardingFailed a owl:Class ;
    rdfs:subClassOf arbora:OnboardingState ;
    :storedForm "failed" .

arbora:FleetOnboardingMachine_Event_registered a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "registered" .

arbora:FleetOnboardingMachine_Event_debounce_elapsed a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "debounce_elapsed" .

arbora:FleetOnboardingMachine_Event_retry_elapsed a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "retry_elapsed" .

arbora:FleetOnboardingMachine_Event_pass_ok a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "pass_ok" .

arbora:FleetOnboardingMachine_Event_pass_err a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "pass_err" .

arbora:FleetOnboardingMachine_Event_held a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "held" .

arbora:FleetOnboardingMachine_Event_approved a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "approved" .

arbora:FleetOnboardingMachine_Event_authority_live a owl:Class ;
    rdfs:subClassOf arbora:OnboardingEvent ;
    :storedForm "authority_live" .

arbora:FleetOnboardingMachine_idle-registered-debouncing a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingIdle ;
    :toState arbora:OnboardingDebouncing ;
    :firedBy arbora:FleetOnboardingMachine_Event_registered .

arbora:FleetOnboardingMachine_debouncing-registered-debouncing a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingDebouncing ;
    :toState arbora:OnboardingDebouncing ;
    :firedBy arbora:FleetOnboardingMachine_Event_registered .

arbora:FleetOnboardingMachine_debouncing-debounce_elapsed-running a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingDebouncing ;
    :toState arbora:OnboardingRunning ;
    :firedBy arbora:FleetOnboardingMachine_Event_debounce_elapsed .

arbora:FleetOnboardingMachine_running-registered-running a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingRunning ;
    :toState arbora:OnboardingRunning ;
    :firedBy arbora:FleetOnboardingMachine_Event_registered .

arbora:FleetOnboardingMachine_running-pass_ok-idle a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingRunning ;
    :toState arbora:OnboardingIdle ;
    :firedBy arbora:FleetOnboardingMachine_Event_pass_ok .

arbora:FleetOnboardingMachine_running-pass_err-backoff a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingRunning ;
    :toState arbora:OnboardingBackoff ;
    :firedBy arbora:FleetOnboardingMachine_Event_pass_err ;
    :guardedBy arbora:AttemptsLeft .

arbora:FleetOnboardingMachine_running-pass_err-failed a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingRunning ;
    :toState arbora:OnboardingFailed ;
    :firedBy arbora:FleetOnboardingMachine_Event_pass_err ;
    :guardedBy arbora:NoAttemptsLeft .

arbora:FleetOnboardingMachine_running-held-awaiting_approval a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingRunning ;
    :toState arbora:OnboardingAwaitingApproval ;
    :firedBy arbora:FleetOnboardingMachine_Event_held .

arbora:FleetOnboardingMachine_backoff-retry_elapsed-running a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingBackoff ;
    :toState arbora:OnboardingRunning ;
    :firedBy arbora:FleetOnboardingMachine_Event_retry_elapsed .

arbora:FleetOnboardingMachine_awaiting_approval-approved-running a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingAwaitingApproval ;
    :toState arbora:OnboardingRunning ;
    :firedBy arbora:FleetOnboardingMachine_Event_approved .

arbora:FleetOnboardingMachine_failed-authority_live-backoff a owl:Class ;
    rdfs:subClassOf arbora:OnboardingTransition ;
    :fromState arbora:OnboardingFailed ;
    :toState arbora:OnboardingBackoff ;
    :firedBy arbora:FleetOnboardingMachine_Event_authority_live ;
    :guardedBy arbora:OnboardingLeaseLive .

# ---------------------------------------------------------------------------
# Migration plan (ARBORA-HOST-R041.1).
# Python: MigrationState, MigrationEvent, MigrationPlan.EDGES in arbora/control_plane/migrations/models.py.
# ---------------------------------------------------------------------------

arbora:MigrationPlanMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Migration plan" ;
    rdfs:comment "The staged cutover of one migration. Each transition is a new plan version; the stage follows from the state. A rollback is allowed from every state except retired, which is final." ;
    :initialState arbora:MigrationPlanPlanned ;
    :hasState arbora:MigrationPlanPlanned ,
        arbora:MigrationPlanInventoryFrozen ,
        arbora:MigrationPlanBackfillObserving ,
        arbora:MigrationPlanShadowReconciled ,
        arbora:MigrationPlanReadCutover ,
        arbora:MigrationPlanWriteFenced ,
        arbora:MigrationPlanCheckpointed ,
        arbora:MigrationPlanRetired ,
        arbora:MigrationPlanRolledBack .

arbora:MigrationPlanState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Migration plan state" .

arbora:MigrationPlanTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Migration plan transition" .

arbora:MigrationPlanEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Migration plan event" .

arbora:MigrationPlanTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Migration plan transition refused" ;
    rdfs:comment "MigrationTransitionRefused, code migration_transition_refused, fields machine (migration_plan), from_state and event. The state does not change." .

arbora:MigrationPlanPlanned a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "planned" .

arbora:MigrationPlanInventoryFrozen a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "inventory_frozen" .

arbora:MigrationPlanBackfillObserving a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "backfill_observing" .

arbora:MigrationPlanShadowReconciled a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "shadow_reconciled" .

arbora:MigrationPlanReadCutover a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "read_cutover" .

arbora:MigrationPlanWriteFenced a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "write_fenced" .

arbora:MigrationPlanCheckpointed a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "checkpointed" .

arbora:MigrationPlanRetired a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState, :TerminalState ;
    :storedForm "retired" .

arbora:MigrationPlanRolledBack a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanState ;
    :storedForm "rolled_back" .

arbora:MigrationPlanMachine_Event_freeze_inventory a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "freeze_inventory" .

arbora:MigrationPlanMachine_Event_record_backfill a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "record_backfill" .

arbora:MigrationPlanMachine_Event_reconcile_clean a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "reconcile_clean" .

arbora:MigrationPlanMachine_Event_cutover_reads a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "cutover_reads" .

arbora:MigrationPlanMachine_Event_fence_writes a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "fence_writes" .

arbora:MigrationPlanMachine_Event_checkpoint a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "checkpoint" .

arbora:MigrationPlanMachine_Event_retire a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "retire" .

arbora:MigrationPlanMachine_Event_rollback a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanEvent ;
    :storedForm "rollback" .

arbora:MigrationPlanMachine_planned-freeze_inventory-inventory_frozen a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanPlanned ;
    :toState arbora:MigrationPlanInventoryFrozen ;
    :firedBy arbora:MigrationPlanMachine_Event_freeze_inventory .

arbora:MigrationPlanMachine_inventory_frozen-record_backfill-backfill_observing a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
