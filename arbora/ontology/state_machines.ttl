    :firedBy arbora:MigrationPlanMachine_Event_record_backfill .

arbora:MigrationPlanMachine_backfill_observing-reconcile_clean-shadow_reconciled a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanBackfillObserving ;
    :toState arbora:MigrationPlanShadowReconciled ;
    :firedBy arbora:MigrationPlanMachine_Event_reconcile_clean .

arbora:MigrationPlanMachine_shadow_reconciled-cutover_reads-read_cutover a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanShadowReconciled ;
    :toState arbora:MigrationPlanReadCutover ;
    :firedBy arbora:MigrationPlanMachine_Event_cutover_reads .

arbora:MigrationPlanMachine_read_cutover-cutover_reads-read_cutover a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanReadCutover ;
    :toState arbora:MigrationPlanReadCutover ;
