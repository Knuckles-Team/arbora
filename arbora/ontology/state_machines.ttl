arbora:HarnessCredentialMachine_refreshing-refresh_ok-authorized a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialRefreshing ;
    :toState arbora:HarnessCredentialAuthorized ;
    :firedBy arbora:HarnessCredentialMachine_Event_refresh_ok .

arbora:HarnessCredentialMachine_refreshing-refresh_fail-expired a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialRefreshing ;
    :toState arbora:HarnessCredentialExpired ;
    :firedBy arbora:HarnessCredentialMachine_Event_refresh_fail .

arbora:HarnessCredentialMachine_authorized-revoke-revoked a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialAuthorized ;
    :toState arbora:HarnessCredentialRevoked ;
    :firedBy arbora:HarnessCredentialMachine_Event_revoke .

arbora:HarnessCredentialMachine_expired-begin-authorizing a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialExpired ;
