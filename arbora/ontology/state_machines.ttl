    rdfs:label "NoSnapshot" ;
    :storedForm "no_snapshot" .

arbora:CatalogTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Catalog serving transition refused" ;
    rdfs:comment "IllegalCatalogTransition, code CATALOG_TRANSITION_ILLEGAL, fields machine (catalog_serving), from_state and event. The catalog state does not change." .

arbora:CatalogCold a owl:Class ;
    rdfs:subClassOf arbora:CatalogState ;
    :storedForm "cold" .

arbora:CatalogLoading a owl:Class ;
    rdfs:subClassOf arbora:CatalogState ;
