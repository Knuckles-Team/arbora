    :fromState arbora:DeployRunConfigured ;
    :toState arbora:DeployRunBuilt ;
    :firedBy arbora:DeployRunMachine_Event_build .

arbora:DeployRunMachine_built-apply-applied a owl:Class ;
    rdfs:subClassOf arbora:DeployRunTransition ;
    :fromState arbora:DeployRunBuilt ;
    :toState arbora:DeployRunApplied ;
    :firedBy arbora:DeployRunMachine_Event_apply .

arbora:DeployRunMachine_applied-cutover-cut_over a owl:Class ;
    rdfs:subClassOf arbora:DeployRunTransition ;
    :fromState arbora:DeployRunApplied ;
    :toState arbora:DeployRunCutOver ;
    :firedBy arbora:DeployRunMachine_Event_cutover .

arbora:DeployRunMachine_cut_over-first_start-cut_over a owl:Class ;
