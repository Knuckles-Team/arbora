arbora:ScaleExecutionMachine_Event_simulate a owl:Class ;
    rdfs:subClassOf arbora:ScaleExecutionEvent ;
    :storedForm "simulate" .

arbora:ScaleExecutionMachine_Event_succeed a owl:Class ;
    rdfs:subClassOf arbora:ScaleExecutionEvent ;
    :storedForm "succeed" .

arbora:ScaleExecutionMachine_Event_fail a owl:Class ;
    rdfs:subClassOf arbora:ScaleExecutionEvent ;
