# ---------------------------------------------------------------------------
# Workstream attachment (ARBORA-HARNESS-PLUGINS-R004.5).
# Python: AttachmentState, AttachmentEvent, ATTACH_EDGES in arbora/api/ops/workstreams.py.
# ---------------------------------------------------------------------------

arbora:WorkstreamAttachmentMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Workstream attachment" ;
    rdfs:comment "One harness session on one workstream. A checkpoint is valid only while attached; a detach of a detached session is a no-op result, not a transition." ;
    :initialState arbora:WorkstreamAttachmentDetached ;
    :hasState arbora:WorkstreamAttachmentDetached ,
        arbora:WorkstreamAttachmentAttached .

arbora:WorkstreamAttachmentState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Workstream attachment state" .

arbora:WorkstreamAttachmentTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Workstream attachment transition" .

arbora:WorkstreamAttachmentEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Workstream attachment event" .

arbora:WorkstreamAttachmentTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Workstream attachment transition refused" ;
    rdfs:comment "IllegalAttachTransition, code ATTACH_TRANSITION_ILLEGAL. The attachment state does not change." .

arbora:WorkstreamAttachmentDetached a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentState ;
    :storedForm "detached" .

arbora:WorkstreamAttachmentAttached a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentState ;
    :storedForm "attached" .

arbora:WorkstreamAttachmentMachine_Event_attach a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentEvent ;
    :storedForm "attach" .

arbora:WorkstreamAttachmentMachine_Event_checkpoint a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentEvent ;
    :storedForm "checkpoint" .

arbora:WorkstreamAttachmentMachine_Event_detach a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentEvent ;
    :storedForm "detach" .

arbora:WorkstreamAttachmentMachine_detached-attach-attached a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentTransition ;
    :fromState arbora:WorkstreamAttachmentDetached ;
    :toState arbora:WorkstreamAttachmentAttached ;
    :firedBy arbora:WorkstreamAttachmentMachine_Event_attach .

arbora:WorkstreamAttachmentMachine_attached-checkpoint-attached a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentTransition ;
    :fromState arbora:WorkstreamAttachmentAttached ;
    :toState arbora:WorkstreamAttachmentAttached ;
    :firedBy arbora:WorkstreamAttachmentMachine_Event_checkpoint .

arbora:WorkstreamAttachmentMachine_attached-detach-detached a owl:Class ;
    rdfs:subClassOf arbora:WorkstreamAttachmentTransition ;
    :fromState arbora:WorkstreamAttachmentAttached ;
    :toState arbora:WorkstreamAttachmentDetached ;
    :firedBy arbora:WorkstreamAttachmentMachine_Event_detach .

# ---------------------------------------------------------------------------
# Plan lease (ARBORA-OPS-R901, R903).
# Python: PlanState, PlanEvent, PLAN_EDGES in arbora/api/invoke/plan.py.
# ---------------------------------------------------------------------------

arbora:PlanLeaseMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Plan lease" ;
    rdfs:comment "The confirmation lease of one previewed plan: issued, consumed once before its hard expiry, executed, then done or failed; an issued plan that reaches its hard expiry expires." ;
    :initialState arbora:PlanIssued ;
    :hasState arbora:PlanIssued ,
        arbora:PlanConsumed ,
        arbora:PlanExecuting ,
        arbora:PlanDone ,
        arbora:PlanFailed ,
        arbora:PlanExpired .

arbora:PlanState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Plan lease state" .

arbora:PlanTerminalState a owl:Class ;
    rdfs:subClassOf arbora:PlanState, :TerminalState ;
    rdfs:label "Plan lease terminal state" .

arbora:PlanTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Plan lease transition" .

arbora:PlanEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Plan lease event" .

arbora:BeforeHardExpiry a owl:Class ;
    rdfs:subClassOf :TransitionGuard ;
    rdfs:label "Before hard expiry" ;
    :storedForm "before_hard_expiry" .

arbora:PlanTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Plan lease transition refused" ;
    rdfs:comment "IllegalPlanTransition, code PLAN_TRANSITION_ILLEGAL, fields machine (plan_lease), from_state and event. The plan state does not change." .

arbora:PlanIssued a owl:Class ;
    rdfs:subClassOf arbora:PlanState ;
    :storedForm "issued" .

arbora:PlanConsumed a owl:Class ;
    rdfs:subClassOf arbora:PlanState ;
    :storedForm "consumed" .

arbora:PlanExecuting a owl:Class ;
    rdfs:subClassOf arbora:PlanState ;
    :storedForm "executing" .

arbora:PlanDone a owl:Class ;
    rdfs:subClassOf arbora:PlanTerminalState ;
    :storedForm "done" .

arbora:PlanFailed a owl:Class ;
    rdfs:subClassOf arbora:PlanTerminalState ;
    :storedForm "failed" .

arbora:PlanExpired a owl:Class ;
    rdfs:subClassOf arbora:PlanTerminalState ;
    :storedForm "expired" .

arbora:PlanLeaseMachine_Event_consume a owl:Class ;
    rdfs:subClassOf arbora:PlanEvent ;
    :storedForm "consume" .

arbora:PlanLeaseMachine_Event_begin a owl:Class ;
    rdfs:subClassOf arbora:PlanEvent ;
    :storedForm "begin" .

arbora:PlanLeaseMachine_Event_finish_ok a owl:Class ;
    rdfs:subClassOf arbora:PlanEvent ;
    :storedForm "finish_ok" .

arbora:PlanLeaseMachine_Event_finish_err a owl:Class ;
    rdfs:subClassOf arbora:PlanEvent ;
    :storedForm "finish_err" .

arbora:PlanLeaseMachine_Event_expire a owl:Class ;
    rdfs:subClassOf arbora:PlanEvent ;
    :storedForm "expire" .

arbora:PlanLeaseMachine_issued-consume-consumed a owl:Class ;
    rdfs:subClassOf arbora:PlanTransition ;
    :fromState arbora:PlanIssued ;
    :toState arbora:PlanConsumed ;
    :firedBy arbora:PlanLeaseMachine_Event_consume ;
    :guardedBy arbora:BeforeHardExpiry .

arbora:PlanLeaseMachine_consumed-begin-executing a owl:Class ;
    rdfs:subClassOf arbora:PlanTransition ;
    :fromState arbora:PlanConsumed ;
    :toState arbora:PlanExecuting ;
    :firedBy arbora:PlanLeaseMachine_Event_begin .

arbora:PlanLeaseMachine_executing-finish_ok-done a owl:Class ;
    rdfs:subClassOf arbora:PlanTransition ;
    :fromState arbora:PlanExecuting ;
    :toState arbora:PlanDone ;
    :firedBy arbora:PlanLeaseMachine_Event_finish_ok .

arbora:PlanLeaseMachine_executing-finish_err-failed a owl:Class ;
    rdfs:subClassOf arbora:PlanTransition ;
    :fromState arbora:PlanExecuting ;
    :toState arbora:PlanFailed ;
    :firedBy arbora:PlanLeaseMachine_Event_finish_err .

arbora:PlanLeaseMachine_consumed-finish_err-failed a owl:Class ;
    rdfs:subClassOf arbora:PlanTransition ;
    :fromState arbora:PlanConsumed ;
    :toState arbora:PlanFailed ;
    :firedBy arbora:PlanLeaseMachine_Event_finish_err .

arbora:PlanLeaseMachine_issued-expire-expired a owl:Class ;
    rdfs:subClassOf arbora:PlanTransition ;
    :fromState arbora:PlanIssued ;
    :toState arbora:PlanExpired ;
    :firedBy arbora:PlanLeaseMachine_Event_expire .

# ---------------------------------------------------------------------------
# Messaging intake lease (ARBORA-MESSAGING-R800.1003, R800.1005).
# Python: IntakeLeaseState, IntakeLeaseEvent in arbora/messaging/lease.py.
# ---------------------------------------------------------------------------

arbora:IntakeLeaseMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Messaging intake lease" ;
    rdfs:comment "The lease that admits one inbound poller per channel identity: held, suspect after one failed heartbeat, lost on a fence refusal or a lapsed TTL, released on stop; a lost lease is won again through the same engine call as the first acquire." ;
    :initialState arbora:IntakeHeld ;
    :hasState arbora:IntakeHeld ,
        arbora:IntakeSuspect ,
        arbora:IntakeLost ,
        arbora:IntakeReleased .

arbora:IntakeLeaseState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Messaging intake lease state" .

arbora:IntakeLeaseTerminalState a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseState, :TerminalState ;
    rdfs:label "Messaging intake lease terminal state" .

arbora:IntakeLeaseTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Messaging intake lease transition" .

arbora:IntakeLeaseEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Messaging intake lease event" .

arbora:WithinTtl a owl:Class ;
    rdfs:subClassOf :TransitionGuard ;
    rdfs:label "WithinTtl" ;
    :storedForm "within_ttl" .

arbora:IntakeLeaseTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Messaging intake lease transition refused" ;
    rdfs:comment "IllegalIntakeLeaseTransition, code INTAKE_LEASE_TRANSITION_ILLEGAL, fields machine (messaging_intake_lease), from_state and event. The lease state does not change." .

arbora:IntakeHeld a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseState ;
    :storedForm "held" .

arbora:IntakeSuspect a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseState ;
    :storedForm "suspect" .

arbora:IntakeLost a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseState ;
    :storedForm "lost" .

arbora:IntakeReleased a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTerminalState ;
    :storedForm "released" .

arbora:IntakeLeaseMachine_Event_heartbeat_ok a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseEvent ;
    :storedForm "heartbeat_ok" .

arbora:IntakeLeaseMachine_Event_heartbeat_err a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseEvent ;
    :storedForm "heartbeat_err" .

arbora:IntakeLeaseMachine_Event_fence_refused a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseEvent ;
    :storedForm "fence_refused" .

arbora:IntakeLeaseMachine_Event_ttl_lapsed a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseEvent ;
    :storedForm "ttl_lapsed" .

arbora:IntakeLeaseMachine_Event_reacquired a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseEvent ;
    :storedForm "reacquired" .

arbora:IntakeLeaseMachine_Event_release a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseEvent ;
    :storedForm "release" .

arbora:IntakeLeaseMachine_held-heartbeat_ok-held a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeHeld ;
    :toState arbora:IntakeHeld ;
    :firedBy arbora:IntakeLeaseMachine_Event_heartbeat_ok .

arbora:IntakeLeaseMachine_held-heartbeat_err-suspect a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeHeld ;
    :toState arbora:IntakeSuspect ;
    :firedBy arbora:IntakeLeaseMachine_Event_heartbeat_err .

arbora:IntakeLeaseMachine_suspect-heartbeat_ok-held a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeSuspect ;
    :toState arbora:IntakeHeld ;
    :firedBy arbora:IntakeLeaseMachine_Event_heartbeat_ok .

arbora:IntakeLeaseMachine_suspect-heartbeat_err-suspect a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeSuspect ;
    :toState arbora:IntakeSuspect ;
    :firedBy arbora:IntakeLeaseMachine_Event_heartbeat_err ;
    :guardedBy arbora:WithinTtl .

arbora:IntakeLeaseMachine_held-fence_refused-lost a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeHeld ;
    :toState arbora:IntakeLost ;
    :firedBy arbora:IntakeLeaseMachine_Event_fence_refused .

arbora:IntakeLeaseMachine_suspect-fence_refused-lost a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeSuspect ;
    :toState arbora:IntakeLost ;
    :firedBy arbora:IntakeLeaseMachine_Event_fence_refused .

arbora:IntakeLeaseMachine_held-ttl_lapsed-lost a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeHeld ;
    :toState arbora:IntakeLost ;
    :firedBy arbora:IntakeLeaseMachine_Event_ttl_lapsed .

arbora:IntakeLeaseMachine_suspect-ttl_lapsed-lost a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeSuspect ;
    :toState arbora:IntakeLost ;
    :firedBy arbora:IntakeLeaseMachine_Event_ttl_lapsed .

arbora:IntakeLeaseMachine_lost-reacquired-held a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeLost ;
    :toState arbora:IntakeHeld ;
    :firedBy arbora:IntakeLeaseMachine_Event_reacquired .

arbora:IntakeLeaseMachine_held-release-released a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeHeld ;
    :toState arbora:IntakeReleased ;
    :firedBy arbora:IntakeLeaseMachine_Event_release .

arbora:IntakeLeaseMachine_suspect-release-released a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeSuspect ;
    :toState arbora:IntakeReleased ;
    :firedBy arbora:IntakeLeaseMachine_Event_release .

arbora:IntakeLeaseMachine_lost-release-released a owl:Class ;
    rdfs:subClassOf arbora:IntakeLeaseTransition ;
    :fromState arbora:IntakeLost ;
    :toState arbora:IntakeReleased ;
    :firedBy arbora:IntakeLeaseMachine_Event_release .

# ---------------------------------------------------------------------------
# Connector desired status (ARBORA-FLEET-R082.1, R082.3).
# Python: DesiredEvent, DESIRED_EDGES in arbora/control_plane/connectors/machine.py.
# ---------------------------------------------------------------------------

arbora:ConnectorDesiredStatusMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Connector desired status" ;
    rdfs:comment "The operator-owned target state of one connector: disabled, enabled or quarantined; quarantined leaves only through release, to disabled. Authorization outcome is a projection of the medulla decision and has no arbora state classes." ;
    :initialState arbora:DesiredDisabled ;
    :hasState arbora:DesiredDisabled ,
        arbora:DesiredEnabled ,
        arbora:DesiredQuarantined .

arbora:ConnectorDesiredState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Connector desired status state" .

arbora:ConnectorDesiredTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Connector desired status transition" .

arbora:ConnectorDesiredEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Connector desired status event" .

arbora:ConnectorDesiredTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Connector desired status transition refused" ;
    rdfs:comment "IllegalDesiredTransition, code CONNECTOR_TRANSITION_ILLEGAL, fields machine (connector_desired_status), from_state and event. The desired status does not change." .

arbora:DesiredDisabled a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredState ;
    :storedForm "disabled" .

arbora:DesiredEnabled a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredState ;
    :storedForm "enabled" .

arbora:DesiredQuarantined a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredState ;
    :storedForm "quarantined" .

arbora:ConnectorDesiredStatusMachine_Event_enable a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredEvent ;
    :storedForm "enable" .

arbora:ConnectorDesiredStatusMachine_Event_disable a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredEvent ;
    :storedForm "disable" .

arbora:ConnectorDesiredStatusMachine_Event_quarantine a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredEvent ;
    :storedForm "quarantine" .

arbora:ConnectorDesiredStatusMachine_Event_release a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredEvent ;
    :storedForm "release" .

arbora:ConnectorDesiredStatusMachine_disabled-enable-enabled a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredTransition ;
    :fromState arbora:DesiredDisabled ;
    :toState arbora:DesiredEnabled ;
    :firedBy arbora:ConnectorDesiredStatusMachine_Event_enable .

arbora:ConnectorDesiredStatusMachine_enabled-disable-disabled a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredTransition ;
    :fromState arbora:DesiredEnabled ;
    :toState arbora:DesiredDisabled ;
    :firedBy arbora:ConnectorDesiredStatusMachine_Event_disable .

arbora:ConnectorDesiredStatusMachine_disabled-quarantine-quarantined a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredTransition ;
    :fromState arbora:DesiredDisabled ;
    :toState arbora:DesiredQuarantined ;
    :firedBy arbora:ConnectorDesiredStatusMachine_Event_quarantine .

arbora:ConnectorDesiredStatusMachine_enabled-quarantine-quarantined a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredTransition ;
    :fromState arbora:DesiredEnabled ;
    :toState arbora:DesiredQuarantined ;
    :firedBy arbora:ConnectorDesiredStatusMachine_Event_quarantine .

arbora:ConnectorDesiredStatusMachine_quarantined-release-disabled a owl:Class ;
    rdfs:subClassOf arbora:ConnectorDesiredTransition ;
    :fromState arbora:DesiredQuarantined ;
    :toState arbora:DesiredDisabled ;
    :firedBy arbora:ConnectorDesiredStatusMachine_Event_release .


# ---------------------------------------------------------------------------
# Catalog serving (ARBORA-FLEET-R081.1, R081.3).
# Python: CatalogState, CatalogEvent, CATALOG_EDGES in arbora/api/domain/fleet/catalog_machine.py.
# ---------------------------------------------------------------------------

arbora:CatalogServingMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Catalog serving" ;
    rdfs:comment "The serving state of the fleet catalog: cold until the first read, loading, snapshot once read, serving once the children are up, degraded when a later read fails (the stale snapshot is served), closing at shutdown." ;
    :initialState arbora:CatalogCold ;
    :hasState arbora:CatalogCold ,
        arbora:CatalogLoading ,
        arbora:CatalogSnapshot ,
        arbora:CatalogServing ,
        arbora:CatalogDegraded ,
        arbora:CatalogClosing .

arbora:CatalogState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Catalog serving state" .

