arbora:DeployRunMachine_serving-onboard-serving a owl:Class ;
    rdfs:subClassOf arbora:DeployRunTransition ;
    :fromState arbora:DeployRunServing ;
    :toState arbora:DeployRunServing ;
    :firedBy arbora:DeployRunMachine_Event_onboard .

arbora:DeployRunMachine_serving-enrol-serving a owl:Class ;
    rdfs:subClassOf arbora:DeployRunTransition ;
    :fromState arbora:DeployRunServing ;
    :toState arbora:DeployRunServing ;
