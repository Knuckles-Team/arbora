# ---------------------------------------------------------------------------
# Cohort read cutover (ARBORA-HOST-R041.1).
# Python: CutoverState, CutoverEvent, CohortReadCutover.EDGES in arbora/control_plane/migrations/models.py.
# ---------------------------------------------------------------------------

arbora:CohortReadCutoverMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Cohort read cutover" ;
    rdfs:comment "One cohort-scoped registry read cutover. It is active until its migration rolls back." ;
    :initialState arbora:CohortReadCutoverActive ;
    :hasState arbora:CohortReadCutoverActive ,
        arbora:CohortReadCutoverRolledBack .

arbora:CohortReadCutoverState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Cohort read cutover state" .

arbora:CohortReadCutoverTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Cohort read cutover transition" .

arbora:CohortReadCutoverEvent a owl:Class ;
