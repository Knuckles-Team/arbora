arbora:MigrationPlanMachine_read_cutover-fence_writes-write_fenced a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanReadCutover ;
    :toState arbora:MigrationPlanWriteFenced ;
    :firedBy arbora:MigrationPlanMachine_Event_fence_writes .

arbora:MigrationPlanMachine_write_fenced-checkpoint-checkpointed a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanWriteFenced ;
    :toState arbora:MigrationPlanCheckpointed ;
    :firedBy arbora:MigrationPlanMachine_Event_checkpoint .

arbora:MigrationPlanMachine_checkpointed-retire-retired a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanCheckpointed ;
    :toState arbora:MigrationPlanRetired ;
    :firedBy arbora:MigrationPlanMachine_Event_retire .

arbora:MigrationPlanMachine_planned-rollback-rolled_back a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanPlanned ;
    :toState arbora:MigrationPlanRolledBack ;
    :firedBy arbora:MigrationPlanMachine_Event_rollback .

arbora:MigrationPlanMachine_inventory_frozen-rollback-rolled_back a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
