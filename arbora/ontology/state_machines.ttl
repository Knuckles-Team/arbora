arbora:HarnessCredentialRevoked a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialState ;
    :storedForm "revoked" .

arbora:HarnessCredentialMachine_Event_begin a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "begin" .

arbora:HarnessCredentialMachine_Event_grant a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "grant" .

arbora:HarnessCredentialMachine_Event_deny a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "deny" .

arbora:HarnessCredentialMachine_Event_refresh_due a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "refresh_due" .

arbora:HarnessCredentialMachine_Event_refresh_ok a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "refresh_ok" .

arbora:HarnessCredentialMachine_Event_refresh_fail a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "refresh_fail" .

arbora:HarnessCredentialMachine_Event_revoke a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialEvent ;
    :storedForm "revoke" .

arbora:HarnessCredentialMachine_unauthenticated-begin-authorizing a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialUnauthenticated ;
    :toState arbora:HarnessCredentialAuthorizing ;
    :firedBy arbora:HarnessCredentialMachine_Event_begin .

arbora:HarnessCredentialMachine_authorizing-grant-authorized a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialAuthorizing ;
    :toState arbora:HarnessCredentialAuthorized ;
    :firedBy arbora:HarnessCredentialMachine_Event_grant .

arbora:HarnessCredentialMachine_authorizing-deny-unauthenticated a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialAuthorizing ;
    :toState arbora:HarnessCredentialUnauthenticated ;
    :firedBy arbora:HarnessCredentialMachine_Event_deny .

arbora:HarnessCredentialMachine_authorized-refresh_due-refreshing a owl:Class ;
    rdfs:subClassOf arbora:HarnessCredentialTransition ;
    :fromState arbora:HarnessCredentialAuthorized ;
    :toState arbora:HarnessCredentialRefreshing ;
