arbora:MigrationPlanMachine_backfill_observing-rollback-rolled_back a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanBackfillObserving ;
    :toState arbora:MigrationPlanRolledBack ;
    :firedBy arbora:MigrationPlanMachine_Event_rollback .

arbora:MigrationPlanMachine_shadow_reconciled-rollback-rolled_back a owl:Class ;
    rdfs:subClassOf arbora:MigrationPlanTransition ;
    :fromState arbora:MigrationPlanShadowReconciled ;
    :toState arbora:MigrationPlanRolledBack ;
