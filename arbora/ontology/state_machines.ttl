    :fromState arbora:NotificationIdentityUnread ;
    :toState arbora:NotificationIdentityRead ;
    :firedBy arbora:NotificationIdentityMachine_Event_mark_read .

# ---------------------------------------------------------------------------
# Support identity (ARBORA-HOST-R041.2).
# Python: SupportState, SupportEvent, SupportIdentity.EDGES in arbora/control_plane/webui/models.py.
# ---------------------------------------------------------------------------

arbora:SupportIdentityMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Support identity" ;
    rdfs:comment "One support request of the web UI. It is open until closed and returns to open when reopened." ;
    :initialState arbora:SupportIdentityOpen ;
    :hasState arbora:SupportIdentityOpen ,
        arbora:SupportIdentityClosed .

arbora:SupportIdentityState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Support identity state" .

arbora:SupportIdentityTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Support identity transition" .

arbora:SupportIdentityEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Support identity event" .

arbora:SupportIdentityTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Support identity transition refused" ;
    rdfs:comment "WebUiTransitionRefused, code webui_transition_refused, fields machine (support), from_state and event. The state does not change." .

arbora:SupportIdentityOpen a owl:Class ;
    rdfs:subClassOf arbora:SupportIdentityState ;
    :storedForm "open" .

arbora:SupportIdentityClosed a owl:Class ;
    rdfs:subClassOf arbora:SupportIdentityState ;
    :storedForm "closed" .

arbora:SupportIdentityMachine_Event_close a owl:Class ;
    rdfs:subClassOf arbora:SupportIdentityEvent ;
    :storedForm "close" .

arbora:SupportIdentityMachine_Event_reopen a owl:Class ;
    rdfs:subClassOf arbora:SupportIdentityEvent ;
    :storedForm "reopen" .

arbora:SupportIdentityMachine_open-close-closed a owl:Class ;
    rdfs:subClassOf arbora:SupportIdentityTransition ;
    :fromState arbora:SupportIdentityOpen ;
    :toState arbora:SupportIdentityClosed ;
    :firedBy arbora:SupportIdentityMachine_Event_close .

arbora:SupportIdentityMachine_closed-reopen-open a owl:Class ;
    rdfs:subClassOf arbora:SupportIdentityTransition ;
    :fromState arbora:SupportIdentityClosed ;
    :toState arbora:SupportIdentityOpen ;
    :firedBy arbora:SupportIdentityMachine_Event_reopen .

# ---------------------------------------------------------------------------
# Deploy run (ARBORA-DEPLOY-R602.5).
# Python: DeployState, DeployEvent, EDGES in arbora/deployment/run.py.
# ---------------------------------------------------------------------------

arbora:DeployRunMachine a owl:Class, :StateMachine ;
    rdfs:subClassOf :StateMachine ;
    rdfs:label "Deploy run" ;
    rdfs:comment "The explicit deploy sequence of arbora deploy run. A run walks the forward chain from Planned to Verified; Rollback leaves Applied, CutOver or Serving for RolledBack; Abort leaves any non-terminal state for Failed. Verified, RolledBack and Failed are the three ends of a run." ;
    :initialState arbora:DeployRunPlanned ;
    :hasState arbora:DeployRunPlanned ,
        arbora:DeployRunPreflightPassed ,
        arbora:DeployRunBackedUp ,
        arbora:DeployRunConfigured ,
        arbora:DeployRunBuilt ,
        arbora:DeployRunApplied ,
        arbora:DeployRunCutOver ,
        arbora:DeployRunServing ,
        arbora:DeployRunVerified ,
        arbora:DeployRunRolledBack ,
        arbora:DeployRunFailed .

arbora:DeployRunState a owl:Class ;
    rdfs:subClassOf :State ;
    rdfs:label "Deploy run state" .

arbora:DeployRunTransition a owl:Class ;
    rdfs:subClassOf :Transition ;
    rdfs:label "Deploy run transition" .

arbora:DeployRunEvent a owl:Class ;
    rdfs:subClassOf :TransitionEvent ;
    rdfs:label "Deploy run event" .

arbora:DeployRunTransitionRefused a owl:Class ;
    rdfs:subClassOf arbora:TransitionRefused ;
    rdfs:label "Deploy run transition refused" ;
    rdfs:comment "TransitionIllegal, code DEPLOY_TRANSITION_ILLEGAL, fields machine (deploy_run), from_state and event. The deploy state does not change and nothing is written." .

arbora:DeployRunPlanned a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "Planned" .

arbora:DeployRunPreflightPassed a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "PreflightPassed" .

arbora:DeployRunBackedUp a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "BackedUp" .

arbora:DeployRunConfigured a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "Configured" .

arbora:DeployRunBuilt a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "Built" .

arbora:DeployRunApplied a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "Applied" .

arbora:DeployRunCutOver a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "CutOver" .

arbora:DeployRunServing a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState ;
    :storedForm "Serving" .

arbora:DeployRunVerified a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState, :TerminalState ;
    :storedForm "Verified" .

arbora:DeployRunRolledBack a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState, :TerminalState ;
    :storedForm "RolledBack" .

arbora:DeployRunFailed a owl:Class ;
    rdfs:subClassOf arbora:DeployRunState, :TerminalState ;
    :storedForm "Failed" .

arbora:DeployRunMachine_Event_preflight a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Preflight" .

arbora:DeployRunMachine_Event_backup a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Backup" .

arbora:DeployRunMachine_Event_config a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Config" .

arbora:DeployRunMachine_Event_build a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Build" .

arbora:DeployRunMachine_Event_apply a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Apply" .

arbora:DeployRunMachine_Event_cutover a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Cutover" .

arbora:DeployRunMachine_Event_first_start a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "FirstStart" .

arbora:DeployRunMachine_Event_serve a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Serve" .

arbora:DeployRunMachine_Event_onboard a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Onboard" .

arbora:DeployRunMachine_Event_enrol a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Enrol" .

arbora:DeployRunMachine_Event_ingest a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Ingest" .

arbora:DeployRunMachine_Event_verify a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Verify" .

arbora:DeployRunMachine_Event_rollback a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Rollback" .

arbora:DeployRunMachine_Event_abort a owl:Class ;
    rdfs:subClassOf arbora:DeployRunEvent ;
    :storedForm "Abort" .

arbora:DeployRunMachine_planned-preflight-preflight_passed a owl:Class ;
    rdfs:subClassOf arbora:DeployRunTransition ;
    :fromState arbora:DeployRunPlanned ;
    :toState arbora:DeployRunPreflightPassed ;
    :firedBy arbora:DeployRunMachine_Event_preflight .

arbora:DeployRunMachine_preflight_passed-backup-backed_up a owl:Class ;
    rdfs:subClassOf arbora:DeployRunTransition ;
    :fromState arbora:DeployRunPreflightPassed ;
